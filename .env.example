# Copy to .env and fill in. Never commit .env – it is git-ignored.
# Empty values mean "not configured"; the platform reports such integrations as PENDING_CONFIGURATION.

# --- Application ---
APP_ENV=local
APP_DEFAULT_LOCALE=pl
# Comma-separated origins allowed to call the API from a browser (Angular dev server: http://localhost:4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Disable Swagger UI / OpenAPI in production unless it is protected
API_DOCS_ENABLED=true
# Structured JSON logs: ecs | logstash | gelf ; empty = human-readable
LOG_FORMAT=

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=eti
POSTGRES_USER=eti
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Backend run outside docker (./mvnw spring-boot:run) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/eti
DATABASE_USER=eti
DATABASE_PASSWORD=change-me-local-only

# --- Redis ---
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379
# Used by the backend outside docker:
REDIS_URL=redis://:change-me-local-only@localhost:6379

# --- Published ports (bound to 127.0.0.1) ---
BACKEND_PORT=8080
FRONTEND_PORT=8081

# --- AI provider (Stage 5) ---
# openai | anthropic | mistral | azure-openai | ollama
LLM_PROVIDER=
LLM_API_KEY=

# --- Object storage, S3-compatible (Stage 5) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- E-mail (Stage 6) ---
SMTP_HOST=

# --- Stripe (Stage 6) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
