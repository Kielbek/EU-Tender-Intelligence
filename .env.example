# Copy to .env and fill in. Never commit .env – it is git-ignored.
# Empty values mean "not configured"; the platform reports such integrations as PENDING_CONFIGURATION.

# --- Application ---
APP_ENV=local
APP_DEFAULT_LOCALE=pl
# Comma-separated origins allowed to call the API from a browser (Angular dev server: http://localhost:4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Disable Swagger UI / OpenAPI in production unless it is protected
API_DOCS_ENABLED=true
# Base URL of the web app – used in e-mail links (verification, password reset, invitations)
APP_PUBLIC_URL=http://localhost:4200
# Version of the terms of service the user accepts at registration (stored per user)
APP_TERMS_VERSION=2026-11-draft
# Set to false on API-only replicas to disable background schedules (e-mail outbox, ECB rates)
APP_SCHEDULING_ENABLED=true
# Structured JSON logs: ecs | logstash | gelf ; empty = human-readable
LOG_FORMAT=

# --- Security ---
# REQUIRED. HMAC key for access tokens, Base64 of at least 32 random bytes. Generate: openssl rand -base64 32
JWT_SECRET=
# true in production (HTTPS). false only for local plain-HTTP development.
REFRESH_COOKIE_SECURE=false
# Comma-separated e-mails promoted to PLATFORM_ADMIN after they verify their address
PLATFORM_ADMIN_EMAILS=

# --- Reference data (CPV from EU Publications Office, ECB exchange rates) ---
# Import automatically on first start when the tables are empty
REFERENCE_IMPORT_ON_STARTUP=true

# --- TED ingestion ---
# Days imported on the very first start (0 = none). Later runs are incremental (hourly, Mon-Sat, Brussels time).
TED_INITIAL_BACKFILL_DAYS=3
# Disable on API-only replicas or in development without network access to api.ted.europa.eu
TED_SCHEDULE_ENABLED=true

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=eti
POSTGRES_USER=eti
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Backend run outside docker (./mvnw spring-boot:run) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/eti
DATABASE_USER=eti
DATABASE_PASSWORD=change-me-local-only

# --- Redis ---
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379
# Used by the backend outside docker:
REDIS_URL=redis://:change-me-local-only@localhost:6379

# --- Published ports (bound to 127.0.0.1) ---
BACKEND_PORT=8080
FRONTEND_PORT=8081

# --- AI provider (Stage 5) ---
# openai | anthropic | mistral | azure-openai | ollama
LLM_PROVIDER=
LLM_API_KEY=

# --- Object storage, S3-compatible (Stage 5) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- E-mail (SMTP) ---
# docker compose defaults to the local Mailpit catcher (UI: http://localhost:8025).
# Running the backend outside docker against Mailpit: SMTP_HOST=localhost SMTP_PORT=1025 SMTP_AUTH=false SMTP_STARTTLS=false
# Production provider example (leave commented to use Mailpit in docker compose):
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
MAIL_FROM="EU Tender Intelligence <no-reply@localhost>"

# --- Stripe (Stage 6) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
